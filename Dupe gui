CopyDiscord.MouseButton1Click:Connect(function()

    local copied = false

    -- Clipboard API if available in the environment
    if typeof(setclipboard) == "function" then

        local success = pcall(function()

            setclipboard(CONFIG.Discord)

        end)

        copied = success

    end

    if copied then

        CopyDiscord.Text = "Copied!"

        Notification(
            "Discord link copied!"
        )

        task.delay(1.5, function()

            if CopyDiscord.Parent then
                CopyDiscord.Text = "Copy Discord"
            end

        end)

    else

        -- Roblox itself doesn't expose a universal
        -- clipboard API, so select the link as fallback.

        local CopyBox = Instance.new("TextBox")

        CopyBox.Size = UDim2.new(
            0,
